---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/poppins/800.css';
import '../styles/global.css';
import { url, pic, RDV, INSTA, FACEBOOK, LINKEDIN, TEL, TEL_AFFICHE, EMAIL, SITE_NAME, PROD_URL, PREVIEW } from '../lib/site';

interface Props {
  title: string;
  description: string;
  current?: string;
  path: string;            // adresse de la page sur le site final, ex. « /formations »
  image?: string;          // image de partage (chemin « /img/… »)
  type?: 'website' | 'article';
  jsonld?: object[];
  noindex?: boolean;
}
const { title, description, current = '', path, image = '/img/cabinet.jpg', type = 'website', jsonld = [], noindex = false } = Astro.props;
const canonical = PROD_URL + (path === '/' ? '/' : encodeURI(path));
const ogImage = PROD_URL + image;

// Fiche du cabinet pour les moteurs de recherche et les assistants (faits repris du site et de la page Perfactive)
const cabinet = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': PROD_URL + '/#cabinet',
  name: "L'ABC des Réflexes",
  description: "Cabinet spécialisé dans l'intégration des réflexes archaïques pour les enfants, les adolescents et les adultes, à Obernai.",
  url: PROD_URL + '/',
  telephone: TEL,
  email: EMAIL,
  image: PROD_URL + '/img/cabinet.jpg',
  priceRange: '65 € - 95 €',
  address: { '@type': 'PostalAddress', streetAddress: '1 place des Fines Herbes', postalCode: '67210', addressLocality: 'Obernai', addressCountry: 'FR' },
  areaServed: ['Obernai', 'Strasbourg', 'Colmar'],
  founder: { '@type': 'Person', name: 'Sandy Stevens', jobTitle: 'Praticienne et formatrice en réflexes archaïques' },
  employee: [
    { '@type': 'Person', name: 'Sandy Stevens', jobTitle: 'Praticienne et formatrice en réflexes archaïques' },
    { '@type': 'Person', name: 'Marjorie Ebel', jobTitle: 'Praticienne certifiée en réflexes archaïques' },
  ],
  potentialAction: { '@type': 'ReserveAction', target: RDV, name: 'Prendre rendez-vous' },
  sameAs: [INSTA, FACEBOOK, LINKEDIN],
};
const nav = [
  ['/#consultations', 'Consultations', 'consultations'],
  ['/#sandy', 'Qui suis-je', 'sandy'],
  ['/formations', 'Formations', 'formations'],
  ['/blog', 'Blog', 'blog'],
  ['/#contact', 'Contact', 'contact'],
];
---
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{(PREVIEW || noindex) && <meta name="robots" content="noindex, nofollow, noarchive">}
<link rel="canonical" href={canonical}>
<link rel="icon" type="image/png" href={url('/favicon.png')}>
<link rel="alternate" type="application/rss+xml" title="Le blog de l'ABC des réflexes" href={url('/blog-feed.xml')}>
<meta property="og:site_name" content={SITE_NAME}>
<meta property="og:locale" content="fr_FR">
<meta property="og:type" content={type}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta name="twitter:card" content="summary_large_image">
<script type="application/ld+json" set:html={JSON.stringify(cabinet)}></script>
{jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)}></script>)}
</head>
<body>
<a class="skip" href="#contenu">Aller au contenu</a>
<header class="top">
  <div class="wrap">
    <a class="brand" href={url('/')}><img src={pic('/img/logo.png').src} alt="" width="52" height="52"><span><b>L'ABC des réflexes</b><span>Sandy Stevens · Obernai</span></span></a>
    <nav class="nav" id="nav" aria-label="Navigation principale">
      {nav.map(([href, label, key]) => <a href={url(href)} class={key === current ? 'on' : undefined}>{label}</a>)}
      <a class="btn small" href={RDV} target="_blank" rel="noopener">Prendre rendez-vous</a>
    </nav>
    <button class="burger" id="burger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="nav">
      <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#09371F" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>
</header>
<main id="contenu">
  <slot />
</main>
<footer>
  <div class="wrap">
    <div style="max-width:320px"><b>L'ABC des réflexes</b>Sandy Stevens, praticienne et formatrice en réflexes archaïques à Obernai, à 25 minutes de Strasbourg et 40 minutes de Colmar.</div>
    <div><b>Le site</b><a href={url('/#consultations')}>Consultations</a><a href={url('/formations')}>Formations</a><a href={url('/blog')}>Blog</a><a href={url('/#contact')}>Contact</a></div>
    <div><b>Me joindre</b><a href={'tel:' + TEL}>{TEL_AFFICHE}</a><a href={'mailto:' + EMAIL}>{EMAIL}</a><a href={RDV} target="_blank" rel="noopener">Prendre rendez-vous en ligne</a></div>
    <div><b>Me suivre</b><a href={INSTA} target="_blank" rel="noopener">Instagram</a><a href={FACEBOOK} target="_blank" rel="noopener">Facebook</a><a href={LINKEDIN} target="_blank" rel="noopener">LinkedIn</a></div>
    <p class="legal">© {new Date().getFullYear()} L'ABC des réflexes · Mon approche en réflexes ne se substitue pas à des traitements ou à des suivis médicaux. · <a href={url('/mentions-legales')} style="display:inline">Mentions légales</a> · <a href={url('/politique-cookies')} style="display:inline">Cookies</a></p>
  </div>
</footer>
<script is:inline>
(function(){ var b=document.getElementById('burger'), n=document.getElementById('nav'); b.addEventListener('click',function(){ var o=n.classList.toggle('open'); b.setAttribute('aria-expanded',o); }); n.addEventListener('click',function(e){ if(e.target.tagName==='A') n.classList.remove('open'); }); })();
</script>
</body>
</html>
