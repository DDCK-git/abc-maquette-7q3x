---
import Base from '../layouts/Base.astro';
import { url, pic, EMAIL, PROD_URL, PREVENTE_URL, PREVENTE_PRIX } from '../lib/site';

// Bouton d'achat : le lien de paiement quand il existe, sinon un e-mail de réservation
const acheter = PREVENTE_URL || 'mailto:' + EMAIL + '?subject=' + encodeURIComponent('Je réserve le programme du soir');
const demo = url('/demo-programme/index.html');
const prix = PREVENTE_PRIX + ' €';

// Les 6 signes : grille de l'article « Réflexe de Moro et sommeil »
const signes = [
  'Il se réveille en sursaut, sans raison apparente',
  'Il dort les bras en croix ou les poings serrés',
  'Il sursaute au moindre bruit, même léger',
  "Il a du mal à s'endormir seul, il a besoin d'être rassuré en continu",
  "Il réagit fort à la lumière, au toucher, ou à d'autres stimulations sensorielles",
  'Il semble « sur ses gardes » même quand tout est calme',
];

const etapes = [
  ['Comprendre', "Un repérage en 6 questions te dit par où commencer. Ensuite, chaque geste t'explique le réflexe en jeu."],
  ['Agir', 'Ton MINI choisit chaque soir son geste en touchant un petit bonhomme animé, et vous le faites ensemble en 7 minutes.'],
  ["S'engager", 'Tu choisis tes soirs et ton heure, et ton téléphone te le rappelle. À 4 soirs par semaine, le programme dure 6 semaines.'],
  ['Demander', "Sandy répond chaque semaine à la question d'un parent, et tu retrouves toutes les réponses précédentes."],
];

// Bonshommes animés : les mêmes que dans le programme
const S = (b: string) => `<svg aria-hidden="true" width="72" height="72" viewBox="0 0 64 64" fill="none" stroke="#09371F" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">${b}</svg>`;
const PK = ' stroke="#FC3C80" stroke-width="2.5"';
const G = '<path d="M4 60h56" stroke-width="2.5"/>';
const H = (x: number, y: number) => `<circle cx="${x}" cy="${y}" r="5.5" fill="#FFFFFF"/>`;
const gestes = [
  { nom: 'Le tournesol', c: '#FFF1CC', txt: 'Allongé sur le dos, ton enfant écarte bras et jambes en étoile, puis les ramène doucement au centre du corps, comme pour se faire un câlin à lui-même.',
    svg: S(`<g class="fa">${H(32, 12)}<path d="M32 18v20M32 24L14 16M32 24l18-8M32 38L18 56M32 38l14 18"/><path d="M8 28q-4 7 0 14M56 28q4 7 0 14"${PK}/></g><g class="fb">${H(32, 14)}<path d="M32 20v18M32 25l-9 6 11 3M32 25l9 6-11 3M32 38l-5 10 4 8M32 38l5 10-4 8"/></g>`) },
  { nom: 'Le koala', c: '#FFE6E0', txt: "Ton enfant est assis, tu places tes mains sous ses bras et tu le berces doucement d'un côté à l'autre, en gardant un contact stable et sécurisant.",
    svg: S(`${G}<g class="rock">${H(32, 18)}<path d="M32 24v20M32 44l-12 8M32 44l12 8"/><path d="M21 30q-5 5 0 10M43 30q5 5 0 10"${PK}/></g><path d="M22 8c7-4 13-4 20 0M22 8l1 5M22 8l5-1M42 8l-1 5M42 8l-5-1"${PK}/>`) },
  { nom: "L'enveloppement", c: '#FFE1EB', txt: 'Un câlin ferme et enveloppant, bras autour du corps, en respirant calmement avec lui. Tu peux aussi installer un plaid tout doux autour de ton enfant.',
    svg: S(`${G}${H(32, 16)}<path d="M19 32q13-11 26 0v20q-13 6-26 0z" fill="#FFFFFF"/><path d="M19 36q13 8 26 0" stroke-width="2.5"/><g class="fa"><path d="M3 42h8M7 38l4 4-4 4M61 42h-8M57 38l-4 4 4 4"${PK}/></g><g class="fb"><path d="M8 42h8M12 38l4 4-4 4M56 42h-8M52 38l-4 4 4 4"${PK}/></g>`) },
  { nom: 'Le bercement sur le ballon', c: '#D9F3F2', txt: "À plat ventre sur le ballon, un léger mouvement de balancement d'avant en arrière ou de rotation douce.",
    svg: S(`${G}<circle cx="32" cy="44" r="15" fill="#FFFFFF"/><g class="rock">${H(10, 23)}<path d="M16 26c10 1 26 0 38 8"/></g><path d="M22 9c7-4 13-4 20 0M22 9l1 5M22 9l5-1M42 9l-1 5M42 9l-5-1"${PK}/>`) },
  { nom: 'Le poids doux', c: '#E3ECE7', txt: 'Allongé sur le ventre, tu fais rouler doucement une grosse peluche sur son dos, jamais sur la nuque ni la tête.',
    svg: S(`<path d="M4 56h56" stroke-width="2.5"/>${H(11, 45)}<path d="M18 49h38"/><g class="fa"><circle cx="30" cy="38" r="7" fill="#FFFFFF"/><circle cx="25" cy="31" r="2.5" fill="#FFFFFF"/><circle cx="35" cy="31" r="2.5" fill="#FFFFFF"/></g><g class="fb"><circle cx="46" cy="38" r="7" fill="#FFFFFF"/><circle cx="41" cy="31" r="2.5" fill="#FFFFFF"/><circle cx="51" cy="31" r="2.5" fill="#FFFFFF"/></g><path d="M30 20h16M42 16l4 4-4 4"${PK}/>`) },
];

const inclus = [
  "Le parcours du soir : 21 jours d'activité, à ton rythme",
  'Cinq gestes de Sandy, chacun relié à son réflexe et expliqué',
  "La grille d'observation, refaite tous les 7 jours d'activité",
  'Tes soirs bloqués dans ton agenda, avec un rappel',
  "La réponse de Sandy à une question de parent, chaque semaine",
  'Le tableau que ton MINI dévoile et garde à la fin',
];

const faq = [
  ['Faut-il installer une application ?', "Non. Le programme s'ouvre dans le navigateur de ton téléphone, sans rien installer."],
  ['Combien de temps ça prend ?', "7 minutes par soir. Le programme compte 21 jours d'activité, que tu répartis sur autant de semaines qu'il te faut."],
  ['Est-ce un abonnement ?', "Non. C'est un paiement unique de " + prix + ', sans abonnement.'],
  ["Et si mon enfant n'aime pas un geste ?", "C'est lui qui choisit son geste chaque soir, parmi trois. Sandy le rappelle : en douceur, jamais en force, et si ton enfant montre un inconfort, on arrête et on observe."],
  ['Quelle différence avec un bilan au cabinet ?', "Le programme te donne des gestes à faire à la maison et t'explique les réflexes. Le bilan de 90 minutes teste les réflexes de ton enfant au cabinet et débouche sur un suivi sur mesure."],
];
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'Product', name: 'Le programme du soir', description: "21 jours d'activité, 7 minutes par soir, pour retrouver des soirées apaisées avec son enfant grâce à des gestes reliés aux réflexes archaïques.",
    brand: { '@id': PROD_URL + '/#cabinet' }, image: PROD_URL + '/img/tableau.svg',
    offers: { '@type': 'Offer', price: PREVENTE_PRIX, priceCurrency: 'EUR', availability: 'https://schema.org/PreOrder', url: PROD_URL + '/programme-du-soir' } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base title="Le programme du soir · Des soirées apaisées avec ton MINI en 7 minutes par soir" description="Un geste par soir, choisi par ton enfant et relié au réflexe de Moro. Le programme de 21 jours de Sandy Stevens, en prévente à 29 €." path="/programme-du-soir" image="/img/cabinet.jpg" jsonld={jsonld} noindex>
  <div class="lp">
    <section class="lp-hero">
      <div class="wrap lp-hero-grid">
        <div>
          <p class="kicker">En prévente · Le programme du soir</p>
          <h1>Retrouve des soirées apaisées avec ton MINI, en 7 minutes par soir</h1>
          <p class="lead">Après une journée à rester assis, à se retenir, à encaisser les bruits et les consignes, beaucoup d'enfants arrivent le soir avec un corps qui n'a pas pu décharger. Ça traîne, ça négocie, ça pleure pour un rien.</p>
          <div class="btns"><a class="btn" href={acheter}>Je réserve ma place à {prix}</a><a class="btn ghost" href={demo}>Essayer la démo</a></div>
          <div class="facts"><span class="fact"><i></i>21 jours d'activité</span><span class="fact"><i></i>7 minutes par soir</span><span class="fact"><i></i>À ton rythme</span><span class="fact"><i></i>Sur ton téléphone, sans rien installer</span></div>
          <p class="note lp-note">Ce programme propose des gestes doux. Ce n'est pas un diagnostic ni un traitement, et si ton enfant ronfle, fait des pauses en respirant ou transpire beaucoup, parles-en aussi à ton médecin.</p>
        </div>
        <div class="phone" aria-label="Aperçu du programme">
          <iframe src={demo} title="Démo du programme du soir" loading="lazy"></iframe>
        </div>
      </div>
    </section>

    <section class="aqua">
      <div class="wrap lp-two">
        <div>
          <p class="kicker">Les signes</p>
          <h2>Tu reconnais peut-être ton enfant dans ces signes</h2>
          <ul class="chev lp-signes">{signes.map((s) => <li>{s}</li>)}</ul>
          <p class="lp-strong">3 cases cochées ou plus ? Le réflexe de Moro est probablement encore actif chez ton enfant.</p>
        </div>
        <div class="card">
          <h3>Le réflexe de Moro, en deux mots</h3>
          <p>Le réflexe de Moro est un réflexe archaïque présent chez tous les bébés dès la naissance. Il déclenche une réaction d'alerte face à un danger perçu.</p>
          <p>Normalement, il s'intègre vers 4 mois. Mais parfois, il reste actif bien après. Le corps reste alors en état d'alerte permanent, même la nuit, même endormi.</p>
          <p><a class="more" href={url('/post/mon-enfant-dort-mal-et-si-c-était-le-réflexe-de-moro')}>Lire l'article de Sandy</a></p>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="head"><p class="kicker">Comment ça marche</p><h2>Le programme t'accompagne soir après soir pendant 21 jours d'activité</h2></div>
        <div class="lp-steps">
          {etapes.map(([v, t], i) => <div class="card"><span class="num">{i + 1}</span><h3>{v}</h3><p>{t}</p></div>)}
        </div>
      </div>
    </section>

    <section class="white">
      <div class="wrap">
        <div class="head"><p class="kicker">Les gestes</p><h2>Chaque geste est relié à un réflexe, et le programme t'explique ce qu'il apporte</h2><p class="lead">Ce sont les gestes que Sandy décrit sur son blog et dans ses posts. Ton MINI choisit le sien chaque soir en touchant le bonhomme qui lui fait envie.</p></div>
        <div class="lp-gestes">
          {gestes.map((g) => <div class="lp-geste" style={'background:' + g.c}><Fragment set:html={g.svg} /><h3>{g.nom}</h3><p>{g.txt}</p></div>)}
        </div>
        <p class="lp-quote">« Quand on travaille ce réflexe avec les bons mouvements, le système nerveux se calme enfin. »<span>Sandy</span></p>
      </div>
    </section>

    <section>
      <div class="wrap lp-two lp-center">
        <img class="lp-tableau" src={url('/img/tableau.svg')} alt="Le tableau du programme : une nuit calme avec une maison, une lune et des collines" width="700" height="300" loading="lazy">
        <div>
          <p class="kicker">La progression</p>
          <h2>Chaque gommette retournée dévoile un morceau du tableau de ton MINI</h2>
          <p>Après son geste, ton enfant retourne la gommette du jour. Au bout des 21 jours, le tableau est complet et il peut le garder.</p>
          <p>De ton côté, tu refais la même grille d'observation tous les 7 jours d'activité, pour voir ce qui bouge.</p>
        </div>
      </div>
    </section>

    <section class="aqua">
      <div class="wrap lp-two lp-center">
        <div class="portrait"><img {...pic('/img/sandy.png')} alt="Portrait de Sandy Stevens" loading="lazy"></div>
        <div>
          <p class="kicker">Qui je suis</p>
          <h2>Je suis Sandy, ancienne maîtresse et praticienne en réflexes archaïques</h2>
          <p>J'ai été maîtresse pendant 15 ans avant de devenir praticienne en réflexes archaïques en 2018, puis formatrice. Je suis aussi maman de deux garçons neuroatypiques : j'ai cherché, galéré, trouvé la clé.</p>
          <p class="lp-strong">Plus de 6 000 parents ont commenté mon post sur les soirées difficiles pour recevoir mon guide.</p>
          <p class="todo">À confirmer par Sandy : ce chiffre (commentaires du post « Ton enfant décharge à fond le soir ») et l'usage d'un témoignage de parent ici.</p>
        </div>
      </div>
    </section>

    <section class="white" id="reserver">
      <div class="wrap lp-two">
        <div class="lp-prix">
          <p class="kicker" style="color:var(--sun)">Tarif de lancement</p>
          <p class="lp-montant">{prix}</p>
          <p>Paiement unique, sans abonnement.</p>
          <ul class="chev lp-inclus">{inclus.map((x) => <li>{x}</li>)}</ul>
          <a class="btn" href={acheter}>Je réserve ma place à {prix}</a>
          <p class="lp-petit">Tu es prévenue par e-mail dès l'ouverture du programme.</p>
        </div>
        <div>
          <h2>Les questions qu'on se pose avant de réserver</h2>
          <div class="lp-faq">
            {faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
          </div>
          <p class="todo">À décider avec Sandy avant d'ouvrir la prévente : la date d'ouverture, le lien de paiement, les âges concernés, ce qui se passe si le programme n'ouvre pas, et son engagement de réponse hebdomadaire.</p>
        </div>
      </div>
    </section>
  </div>
  <div class="buybar"><span><b>{prix}</b> en prévente</span><a class="btn small" href={acheter}>Je réserve ma place</a></div>
</Base>

<style is:global>
.lp-hero{padding:56px 0 72px;background:linear-gradient(180deg,var(--ivory) 0%,var(--aqua) 100%)}
.lp-hero-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:56px;align-items:center}
.lp-hero h1{font-size:clamp(32px,4vw,48px)}
.lp-hero .lead{margin:20px 0 28px;max-width:600px}
.lp-note{margin-top:26px;max-width:600px;font-size:13.5px}
.phone{width:340px;height:690px;margin-left:auto;border-radius:46px;border:10px solid var(--ink);overflow:hidden;background:#fff;box-shadow:0 34px 70px rgba(9,55,31,.28)}
.phone iframe{width:100%;height:100%;border:0;display:block}
.lp-two{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:56px;align-items:start}
.lp-center{align-items:center}
.lp h2{margin-bottom:18px}
.lp p+p{margin-top:14px}
.lp-signes li{font-size:17px;margin:11px 0}
.lp-strong{font-weight:600;font-size:18px;line-height:1.5;margin-top:22px}
.lp-steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}
.lp-gestes{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:16px}
.lp-geste{border-radius:var(--r-md);padding:22px 18px;display:flex;flex-direction:column;gap:10px}
.lp-geste svg{overflow:visible}
.lp-geste h3{font-size:17px}
.lp-geste p{font-size:14.5px;line-height:1.55}
.lp-quote{max-width:780px;margin:56px auto 0;text-align:center;font-size:clamp(20px,2.3vw,26px);line-height:1.45;font-weight:600}
.lp-quote span{display:block;margin-top:12px;font-size:15px;font-weight:400;color:var(--ink-2)}
.lp-tableau{width:100%;height:auto;border-radius:var(--r-lg);box-shadow:0 24px 50px rgba(9,55,31,.18)}
.lp-prix{background:var(--ink);color:#fff;border-radius:var(--r-lg);padding:40px;display:flex;flex-direction:column;gap:14px;align-items:flex-start}
.lp-prix p{margin:0}
.lp-montant{font-size:64px;font-weight:800;line-height:1}
.lp-inclus{margin:8px 0 12px}
.lp-inclus li{margin:10px 0;font-size:16px}
.lp-inclus li::before{color:var(--sun)}
.lp-petit{font-size:13.5px;color:#CFE0D8}
.lp-faq details{border-bottom:1px solid var(--line);padding:16px 0}
.lp-faq summary{font-weight:600;font-size:17px;cursor:pointer;list-style-position:inside}
.lp-faq p{margin-top:10px;color:var(--ink-2)}
.lp .todo{margin-top:22px}
.buybar{display:none}
@keyframes lpfa{0%,49.9%{opacity:1}50%,100%{opacity:0}}
@keyframes lpfb{0%,49.9%{opacity:0}50%,100%{opacity:1}}
@keyframes lprock{from{transform:rotate(-7deg)}to{transform:rotate(7deg)}}
.lp .fa{animation:lpfa 1.4s linear infinite}
.lp .fb{opacity:0;animation:lpfb 1.4s linear infinite}
.lp .rock{transform-box:view-box;transform-origin:32px 44px;animation:lprock 1.6s ease-in-out infinite alternate}
@media (prefers-reduced-motion:reduce){.lp .fa,.lp .fb,.lp .rock{animation:none}}
@media (max-width:1000px){
  .lp-gestes{grid-template-columns:repeat(2,minmax(0,1fr))}
  .lp-steps{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media (max-width:900px){
  .lp-hero{padding:32px 0 48px}
  .lp-hero-grid,.lp-two{grid-template-columns:minmax(0,1fr);gap:32px}
  .phone{display:none}
  .lp-steps,.lp-gestes{grid-template-columns:minmax(0,1fr)}
  .lp-geste{flex-direction:row;align-items:center;flex-wrap:wrap}
  .lp-geste p{flex-basis:100%}
  .lp-prix{padding:28px}
  .buybar{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:30;background:#fff;border-top:1px solid var(--line);padding:10px 16px;align-items:center;justify-content:space-between;gap:12px;font-size:15px}
  footer{padding-bottom:96px}
}
</style>
