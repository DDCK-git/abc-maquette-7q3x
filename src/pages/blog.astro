---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { allPosts } from '../lib/site';
const posts = await allPosts();
---
<Base title="Le blog · L'ABC des réflexes" description="Les comportements du quotidien décodés avec l'éclairage des réflexes archaïques : sommeil, devoirs, posture, bouche, émotions." current="blog" path="/blog">
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">Le blog</p>
      <h1>Je décode ici les comportements du quotidien</h1>
      <p class="lead">Chaque article part d'une situation que tu vis à la maison ou en classe et l'explique avec l'éclairage des réflexes archaïques.</p>
      <p style="margin-top:26px"><label for="q" class="muted" style="display:block;font-size:14px;font-weight:600;margin-bottom:8px">Chercher un article</label><input id="q" type="search" placeholder="sommeil, devoirs, Moro…" class="search"></p>
    </div>
  </section>
  <section>
    <div class="wrap">
      <div class="posts" id="posts">{posts.map((p, i) => <PostCard post={p} big={i === 0} />)}</div>
      <p id="none" class="lead" hidden>Aucun article ne correspond à cette recherche.</p>
    </div>
  </section>
  <script is:inline>
  (function(){ var q=document.getElementById('q'), ps=[].slice.call(document.querySelectorAll('#posts .post')), none=document.getElementById('none');
    function norm(s){ return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,''); }
    q.addEventListener('input',function(){ var v=norm(q.value.trim()), n=0; ps.forEach(function(p){ var ok=!v||norm(p.textContent).indexOf(v)>=0; p.hidden=!ok; p.classList.toggle('big',!v&&p===ps[0]); if(ok) n++; }); none.hidden=n>0; }); })();
  </script>
</Base>
