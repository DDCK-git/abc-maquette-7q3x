---
import { url, pic, postPath, dateFr, excerpt, type Post } from '../lib/site';
interface Props { post: Post; big?: boolean; level?: 'h2' | 'h3' }
const { post, big = false, level: Title = 'h3' } = Astro.props;
---
<a class:list={['post', { big }]} href={url(postPath(post))}>
  {post.data.cover && <img {...pic(post.data.cover)} alt="" loading={big ? 'eager' : 'lazy'} fetchpriority={big ? 'high' : undefined} decoding="async">}
  <div>
    <time datetime={post.data.date.toISOString().slice(0, 10)}>{dateFr(post.data.date)}</time>
    <Title class="t">{post.data.title}</Title>
    <p>{excerpt(post.data.description)}</p>
  </div>
</a>
